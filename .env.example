# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# --- Database (Neon) ---------------------------------------------------------
# Production: Neon *pooled* connection string (host contains "-pooler"),
# e.g. postgres://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Local dev: the PGlite server started by `npm run db:local`.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# --- Auth --------------------------------------------------------------------
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
BETTER_AUTH_SECRET=
# The public URL of the app (https://your-domain in production).
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# One-time token to create the first admin at /setup. Remove it after setup.
SETUP_TOKEN=

# --- Email (Resend) ----------------------------------------------------------
# Without a key, login codes are printed to the server console (dev only).
RESEND_API_KEY=
EMAIL_FROM="BNI Dheeras <noreply@your-domain.com>"

# --- Images (Cloudflare R2) --------------------------------------------------
# Without these, uploads are stored in ./.local-uploads (dev only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL of the bucket (custom domain or r2.dev URL), no trailing slash.
R2_PUBLIC_BASE_URL=

# --- Maps (free: OpenStreetMap) ------------------------------------------------
# Contact email sent to the free OSM Nominatim address search (usage policy).
NOMINATIM_EMAIL=
# Optional: a different map tile server. Defaults to OpenStreetMap.
NEXT_PUBLIC_MAP_TILE_URL=

# --- Public form spam protection (optional, Cloudflare Turnstile) ------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Scheduled jobs ------------------------------------------------------------
# Vercel sends this as a Bearer token to /api/cron/*.
CRON_SECRET=
